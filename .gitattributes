# Line-ending policy.
#
# Git on Windows converts LF to CRLF on checkout by default. For most files
# that is harmless, but for a shell script it is not: a `#!/usr/bin/env bash`
# line ending in CRLF makes Linux report "bad interpreter: No such file or
# directory", which is a genuinely confusing way to learn about line endings.

* text=auto

# Always LF, whatever platform they are checked out on.
*.sh text eol=lf

# Windows-only, so leave these as CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary: never touch, never diff.
*.jar binary
*.png binary
*.zip binary
